{
  "slug": "lcs-length",
  "title": "Longest Common Subsequence",
  "difficulty": "medium",
  "category": "dsa",
  "tags": [
    "dsa",
    "quant",
    "interview"
  ],
  "statement": [
    {
      "type": "p",
      "md": "Two desks logged their fills as sequences of integer order ids. A common subsequence is a sequence that can be obtained from both logs by deleting some elements without reordering the rest. Find the length of the longest one."
    }
  ],
  "inputFormat": "First line: $n$ and $m$. Second line: $n$ integers. Third line: $m$ integers.",
  "outputFormat": "One integer.",
  "constraints": [
    "$1 \\le n, m \\le 1500$",
    "$|x| \\le 10^9$"
  ],
  "examples": [
    {
      "input": "6 5\n1 3 4 1 2 1\n3 4 1 2 1\n",
      "output": "5\n"
    }
  ],
  "hints": [
    "Let $L(i, j)$ be the answer for the first $i$ elements of $a$ and the first $j$ of $b$. What if $a_i = b_j$?",
    "If they differ, the best subsequence drops either $a_i$ or $b_j$."
  ],
  "editorial": "[{\"type\": \"p\", \"md\": \"$L(i, 0) = L(0, j) = 0$, and $L(i, j) = L(i-1, j-1) + 1$ if $a_i = b_j$, otherwise $\\\\max(L(i-1, j), L(i, j-1))$. Fill row by row in $O(nm)$ time; two rows are enough for memory. About $2.25 \\\\cdot 10^6$ cells at the limits.\"}]",
  "solutions": {
    "python": "import sys\n\n\ndef main():\n    tok = sys.stdin.read().split()\n    n, m = int(tok[0]), int(tok[1])\n    a = tok[2:2 + n]\n    b = tok[2 + n:2 + n + m]\n    prev = [0] * (m + 1)\n    for i in range(1, n + 1):\n        cur = [0] * (m + 1)\n        ai = a[i - 1]\n        for j in range(1, m + 1):\n            cur[j] = prev[j - 1] + 1 if ai == b[j - 1] else max(prev[j], cur[j - 1])\n        prev = cur\n    print(prev[m])\n\n\nmain()",
    "cpp": "#include <algorithm>\n#include <iostream>\n#include <vector>\nusing namespace std;\n\nint main() {\n    ios::sync_with_stdio(false);\n    cin.tie(nullptr);\n    int n, m;\n    cin >> n >> m;\n    vector<long long> a(n), b(m);\n    for (auto& x : a) cin >> x;\n    for (auto& x : b) cin >> x;\n    vector<int> prev(m + 1, 0), cur(m + 1, 0);\n    for (int i = 1; i <= n; i++) {\n        for (int j = 1; j <= m; j++)\n            cur[j] = a[i - 1] == b[j - 1] ? prev[j - 1] + 1 : max(prev[j], cur[j - 1]);\n        swap(prev, cur);\n    }\n    cout << prev[m] << '\\n';\n    return 0;\n}"
  },
