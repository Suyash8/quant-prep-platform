  "solutions": {
    "python": "import sys\nfrom collections import deque\n\ndef main():\n data = sys.stdin.buffer.read().split()\n n = int(data[0])\n bids = {} # price in cents -> FIFO deque of resting order quantities\n asks = {}\n out = []\n\n def fmt(c):\n return f\"{c // 100}.{c % 100:02d}\"\n\n idx = 1\n for _ in range(n):\n typ = data[idx].decode(); idx += 1\n if typ == \"L\":\n side = data[idx].decode(); price = int(data[idx + 1]); qty = int(data[idx + 2]); idx += 3\n book = bids if side == \"B\" else asks\n if price not in book:\n book[price] = deque()\n book[price].append(qty)\n else:\n side = data[idx].decode(); qty = int(data[idx + 1]); idx += 2\n if side == \"B\":\n book = asks\n best = min(book) if book else None\n else:\n book = bids\n best = max(book) if book else None\n while qty > 0 and best is not None:\n resting = book[best][0]\n fill = min(resting, qty)\n out.append(f\"T {fmt(best)} {fill}\")\n qty -= fill\n if fill == resting:\n book[best].popleft()\n if not book[best]:\n del book[best]\n else:\n book[best][0] = resting, fill\n if book:\n best = min(book) if side == \"B\" else max(book)\n else:\n best = None\n out.append(\"BID \" + (fmt(max(bids)) if bids else \"-\"))\n out.append(\"ASK \" + (fmt(min(asks)) if asks else \"-\"))\n sys.stdout.write(\"\\n\".join(out) + \"\\n\")\n\nmain()\n",
    "cpp": "#include <bits/stdc++.h>\nusing namespace std;\n\nstatic string fmt(long long c) {\n char buf[32];\n snprintf(buf, sizeof(buf), \"%lld.%02lld\", c / 100, c % 100);\n return string(buf);\n}\n\nint main() {\n int n;\n if (scanf(\"%d\", &n) != 1) return 0;\n map<long long, deque<long long>, greater<long long>> bids; // begin() = best (highest) bid\n map<long long, deque<long long>> asks; // begin() = best (lowest) ask\n string out;\n for (int i = 0; i < n; i++) {\n char t[4], s[4];\n scanf(\"%3s %3s\", t, s);\n bool isBuy = (s[0] == 'B');\n if (t[0] == 'L') {\n long long price, qty;\n scanf(\"%lld %lld\", &price, &qty);\n if (isBuy) bids[price].push_back(qty);\n else asks[price].push_back(qty);\n } else {\n long long qty;\n scanf(\"%lld\", &qty);\n if (isBuy) {\n while (qty > 0 && !asks.empty()) {\n auto it = asks.begin();\n long long price = it->first;\n deque<long long> &dq = it->second;\n long long resting = dq.front();\n long long fill = min(resting, qty);\n out += \"T \";\n out += fmt(price);\n out += ' ';\n out += to_string(fill);\n out += '\\n';\n qty -= fill;\n if (fill == resting) {\n dq.pop_front();\n if (dq.empty()) asks.erase(it);\n } else {\n dq.front() = resting, fill;\n }\n }\n } else {\n while (qty > 0 && !bids.empty()) {\n auto it = bids.begin();\n long long price = it->first;\n deque<long long> &dq = it->second;\n long long resting = dq.front();\n long long fill = min(resting, qty);\n out += \"T \";\n out += fmt(price);\n out += ' ';\n out += to_string(fill);\n out += '\\n';\n qty -= fill;\n if (fill == resting) {\n dq.pop_front();\n if (dq.empty()) bids.erase(it);\n } else {\n dq.front() = resting, fill;\n }\n }\n }\n }\n }\n out += bids.empty() ? \"BID -\\n\" : (\"BID \" + fmt(bids.begin()->first) + \"\\n\");\n out += asks.empty() ? \"ASK -\\n\" : (\"ASK \" + fmt(asks.begin()->first) + \"\\n\");\n fputs(out.c_str(), stdout);\n return 0;\n}\n"
  },
