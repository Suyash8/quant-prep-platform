      "prompt": "What does marginal pricing mean?",
      "options": [
        {
          "id": "0",
          "text": "Final rate on all volume",
          "why": "Applying the final tier rate to all volume is a flat-volume rule, not marginal pricing."
        },
        {
          "id": "1",
          "text": "Cheapest rate on all",
          "why": "Selecting the cheapest rate for all volume ignores the higher-priced slices already consumed."
        },
        {
          "id": "2",
          "text": "Ignore first tier",
          "why": "The first tier contributes its full width when crossed and a partial width for smaller volumes."
        },
        {
          "id": "3",
          "text": "Each slice gets own rate",
          "why": "Split volume across successive tier widths and apply each tier's own rate to its slice."
        }
      ],
      "correct": [
        "3"
      ],
      "explanation": "Sum across disjoint tier widths."
    }
