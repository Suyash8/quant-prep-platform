          "id": "0",
          "text": "10 only,because one packet is one message",
          "why": "The count identifies three message blocks."
        },
        {
          "id": "1",
          "text": "1,2,3 regardless of header",
          "why": "The header supplies the first sequence."
        },
        {
          "id": "2",
          "text": "10,11,12 within that session",
          "why": "Later block positions increment from the first."
        },
        {
          "id": "3",
          "text": "10,13,16 because the count is the stride",
          "why": "The count is not a sequence stride."
