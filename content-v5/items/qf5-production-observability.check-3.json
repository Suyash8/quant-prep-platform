      "prompt": "How should compatible shard error ratios be aggregated?",
      "options": [
        {
          "id": "0",
          "text": "Sum bad and total counts,then divide",
          "why": "This weights events rather than shards."
        },
        {
          "id": "1",
          "text": "Average every shard ratio equally",
          "why": "Unequal sizes distort that average."
        },
