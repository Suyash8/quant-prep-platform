      "prompt": "Why is route-then-immediately-cancel not equivalent to rejecting an excessive order before routing?",
      "options": [
        {
          "id": "0",
          "text": "Every cancellation is guaranteed faster than execution",
          "why": "It can race or fail."
        },
        {
          "id": "1",
          "text": "The source event log becomes irrelevant",
          "why": "Keep audit/reconciliation."
        },
        {
          "id": "2",
          "text": "The cancel request reverses all past fills",
          "why": "It does not."
        },
        {
          "id": "3",
          "text": "Execution can occur before cancellation is confirmed",
          "why": "Prevention and later mitigation are different."
        }
      ],
      "correct": [
