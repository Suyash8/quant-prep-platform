      "prompt": "Two workers each accept a candidate from the same old available-cash snapshot. What is missing?",
      "options": [
        {
          "id": "0",
          "text": "An atomic/revision-checked check-and-reserve commit",
          "why": "Each candidate alone can be valid while their union breaches limits."
        },
        {
          "id": "1",
          "text": "A prettier green badge",
          "why": "Appearance cannot serialize updates."
        },
        {
          "id": "2",
          "text": "An unbounded timestamp retry with no check",
          "why": "Reload and recheck under a defined concurrency protocol."
        },
        {
          "id": "3",
          "text": "Automatic release of all unknown orders",
          "why": "That hides possible exposure."
        }
      ],
      "correct": [
        "0"
      ],
      "explanation": "Serialize or use a transaction/revision conflict protocol around the shared state transition."
