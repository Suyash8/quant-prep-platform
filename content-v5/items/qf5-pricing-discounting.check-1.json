      "kind": "choice",
      "selectionMode": "one",
      "shuffle": true,
      "prompt": "Annual nominal r compounded m times yearly has which factor for supplied year fraction t?",
      "options": [
        {
          "id": "0",
          "text": "exp(-r*t)for every m",
          "why": "That is the continuous convention."
        },
        {
          "id": "1",
          "text": "(1+r/m)^(-m*t)",
          "why": "Require a positive base and matching units."
        },
        {
          "id": "2",
          "text": "(1+r)^t",
          "why": "That grows rather than discounts under positive r."
        },
        {
          "id": "3",
          "text": "r*t regardless of maturity",
          "why": "That is not a discount factor."
        }
      ],
      "correct": [
        "1"
      ],
      "explanation": "The compounding frequency belongs in both the base and exponent."
    }
  ]
