      "prompt": "Aligned nodes coincide: return?",
      "options": [
        {
          "id": "0",
          "text": "Always root",
          "why": "The shared aligned node need not be the root; it is already the lowest common ancestor."
        },
        {
          "id": "1",
          "text": "A child",
          "why": "A child of the shared node cannot be an ancestor of that node."
        },
        {
          "id": "2",
          "text": "Minus one",
          "why": "Self and ancestor queries are valid; they do not require a missing-result sentinel."
        },
        {
          "id": "3",
          "text": "Same node",
          "why": "When alignment makes the nodes identical, that node is the answer without further jumps."
        }
