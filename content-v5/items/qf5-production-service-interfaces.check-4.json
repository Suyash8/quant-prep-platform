      "kind": "choice",
      "selectionMode": "one",
      "shuffle": true,
      "prompt": "Is adding an optional field always safe for every old/new client/server pair?",
      "options": [
        {
          "id": "0",
          "text": "Yes, all decoders ignore extras",
          "why": "This closed one rejects extras."
        },
        {
          "id": "1",
          "text": "Yes, if the version label stays the same",
          "why": "A label cannot supply compatibility."
        },
        {
          "id": "2",
          "text": "Yes, provided the field is optional in the new schema",
          "why": "An old closed decoder can still reject the extra field, even when the new schema calls it optional."
        },
        {
          "id": "3",
          "text": "No, unknown/default/direction rules matter",
          "why": "Test actual wire and semantic combinations."
        }
      ],
      "correct": [
        "3"
      ],
      "explanation": "Compatibility is directional and behavior-dependent."
    }
  ]
