      "shuffle": true,
      "prompt": "A stored sequence is retried with different delta content. What should this own journal do?",
      "options": [
        {
          "id": "0",
          "text": "Treat it as an exact duplicate",
          "why": "Content differs."
        },
        {
          "id": "1",
          "text": "Raise a conflict without committing a change",
          "why": "Identity and normalized content must agree."
        },
        {
          "id": "2",
          "text": "Append both under the same primary key silently",
          "why": "That breaks the identity contract."
        },
        {
          "id": "3",
          "text": "Advance the cursor and omit both",
          "why": "That loses event history."
        }
      ],
      "correct": [
        "1"
      ],
      "explanation": "Sequence identity is source-bound by this one-namespace private model;conflicts are not no-ops."
    }
