          "id": "0",
          "text": "At enqueue",
          "why": "Marking on enqueue ensures each open cell enters the queue once, at its first discovered distance."
        },
        {
          "id": "1",
          "text": "After all neighbors finish",
          "why": "Waiting until neighbors finish lets another queued predecessor enqueue the same cell again."
        },
        {
          "id": "2",
          "text": "Only at target",
          "why": "Only marking the target leaves other cells free to re-enter the queue through cycles."
        },
        {
          "id": "3",
          "text": "At end of traversal",
          "why": "End-of-traversal marking cannot prevent duplicates while traversal is running."
