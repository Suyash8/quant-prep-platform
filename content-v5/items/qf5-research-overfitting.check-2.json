      "shuffle": true,
      "prompt": "What does Bonferroni NOT require across tests when marginal p-values/family are valid?",
      "options": [
        {
          "id": "0",
          "text": "A finite declared family",
          "why": "That remains required for this simple rule."
        },
        {
          "id": "1",
          "text": "Valid marginal null probabilities",
          "why": "That remains required."
        },
        {
          "id": "2",
          "text": "Independence between different tests",
          "why": "Union bound holds without cross-test independence."
        },
        {
          "id": "3",
          "text": "Accounting for all declared comparisons",
          "why": "That remains necessary."
        }
      ],
      "correct": [
        "2"
      ],
      "explanation": "Do not confuse within-test null assumptions with cross-test dependence."
    }
