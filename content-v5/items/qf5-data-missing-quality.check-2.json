      ],
      "kind": "choice",
      "selectionMode": "one",
      "shuffle": true,
      "prompt": "Which entries does np.isfinite flag False in a floating array?",
      "options": [
        {
          "id": "0",
          "text": "Only the value zero",
          "why": "Zero is finite."
        },
        {
          "id": "1",
          "text": "Only negative values",
          "why": "Negative finite numbers are still finite."
        },
        {
          "id": "2",
          "text": "Only explicitly stored None objects",
          "why": "This example uses a floating array, not an object array."
        },
        {
          "id": "3",
          "text": "NaN and either infinity",
          "why": "These are precisely the non-finite floating cases here."
        }
      ],
      "correct": [
        "3"
      ],
      "explanation": "isfinite detects these non-finite cases; it does not enforce a positive-price domain by itself."
    }
  ]
}
