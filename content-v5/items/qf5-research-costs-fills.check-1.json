      "prompt": "A buy fills at an already observed ask. What avoids spread double counting?",
      "options": [
        {
          "id": "0",
          "text": "Always add the full spread again",
          "why": "The ask already includes the quoted half-spread from midpoint."
        },
        {
          "id": "1",
          "text": "State reference and included costs",
          "why": "Add only costs not already represented."
        },
        {
          "id": "2",
          "text": "Treat all fees as price returns",
          "why": "Fees need explicit cash accounting."
        },
        {
          "id": "3",
          "text": "Ignore reference price entirely",
          "why": "Then cost meanings are ambiguous."
        }
      ],
      "correct": [
        "1"
      ],
      "explanation": "A cost field needs its reference and units."
