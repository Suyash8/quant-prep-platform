      "shuffle": true,
      "prompt": "Does passing every component test eliminate integration tests?",
      "options": [
        {
          "id": "0",
          "text": "Yes,units can never mismatch",
          "why": "Boundaries can still disagree."
        },
        {
          "id": "1",
          "text": "Yes, provided each component was tested only with its own unit convention",
          "why": "Individually consistent components can disagree on units, identity or version at their shared boundary."
        },
        {
          "id": "2",
          "text": "No,test boundary contracts",
          "why": "Composition can introduce new failures."
        },
        {
          "id": "3",
          "text": "Only for positive PnL",
          "why": "Outcome cannot establish correctness."
        }
      ],
      "correct": [
        "2"
      ],
      "explanation": "Preserve cross-boundary semantics."
    }
  ]
