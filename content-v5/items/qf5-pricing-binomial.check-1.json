      "kind": "choice",
      "selectionMode": "one",
      "shuffle": true,
      "prompt": "For gross return a, up u, down d, which pricing weight matches the model?",
      "options": [
        {
          "id": "0",
          "text": "The last observed fraction of rising days automatically",
          "why": "Physical estimates are not this replication weight."
        },
        {
          "id": "1",
          "text": "p=(a-d)/(u-d)",
          "why": "Strict d<a<u puts p between 0 and 1."
        },
        {
          "id": "2",
          "text": "p=1 regardless of factors",
          "why": "That ignores replication."
        },
        {
          "id": "3",
          "text": "Clip any negative p to 0 without reporting invalid model",
          "why": "Reject the violated model assumptions."
        }
      ],
      "correct": [
        "1"
      ],
      "explanation": "The weight follows p*u+(1-p)*d=a."
    }
  ]
