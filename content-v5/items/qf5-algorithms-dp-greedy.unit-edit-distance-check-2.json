      "kind": "choice",
      "selectionMode": "one",
      "shuffle": true,
      "prompt": "Combine last-operation costs with what?",
      "options": [
        {
          "id": "0",
          "text": "Sum",
          "why": "The final operation is one alternative, so adding every alternative cost would overcount a path."
        },
        {
          "id": "1",
          "text": "Maximum",
          "why": "Choosing the largest candidate would seek an expensive path rather than edit distance."
        },
        {
          "id": "2",
          "text": "Minimum",
          "why": "Deletion, insertion and match/substitution each complete a feasible path; select the cheapest total cost."
        },
        {
          "id": "3",
          "text": "Product",
          "why": "Multiplying costs has no meaning for the sum of unit edit costs along one path."
        }
      ],
      "correct": [
        "2"
      ],
      "explanation": "Choose cheapest complete feasible alignment."
    }
  ]
