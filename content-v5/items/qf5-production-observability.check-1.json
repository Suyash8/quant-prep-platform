      "kind": "choice",
      "selectionMode": "one",
      "shuffle": true,
      "prompt": "Should unknown timeout latency enter this percentile as zero?",
      "options": [
        {
          "id": "0",
          "text": "Yes,to keep every row numeric",
          "why": "That invents a fast observation."
        },
        {
          "id": "1",
          "text": "No,report unknown separately",
          "why": "Keep the known-sample denominator visible."
        },
        {
          "id": "2",
          "text": "Yes,if it lowers p95",
          "why": "Outcome cannot justify a false value."
        },
        {
          "id": "3",
          "text": "Delete all timeout errors",
          "why": "They still count as bad terminal outcomes."
        }
      ],
      "correct": [
        "1"
      ],
      "explanation": "Missing duration and observed zero differ."
    }
  ]
