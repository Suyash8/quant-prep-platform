      "prompt": "A call raises after final rename. What must recovery do?",
      "options": [
        {
          "id": "0",
          "text": "Assume no output exists",
          "why": "The write may already have committed."
        },
        {
          "id": "1",
          "text": "Inspect expected artifact before retry",
          "why": "Validate exact identity/content and reuse if valid."
        },
        {
          "id": "2",
          "text": "Always delete every artifact",
          "why": "That destroys useful evidence."
        },
        {
          "id": "3",
          "text": "Mark whole batch complete immediately",
          "why": "Other shards may still be missing."
        }
