      "kind": "choice",
      "selectionMode": "one",
      "shuffle": true,
      "prompt": "Under this toy through=LAST APPLIED convention,which event follows through7?",
      "options": [
        {
          "id": "0",
          "text": "7 again,always",
          "why": "That would replay an already included position."
        },
        {
          "id": "1",
          "text": "8,under this declared convention",
          "why": "A different protocol can define its cursor differently."
        },
        {
          "id": "2",
          "text": "Whatever event arrived most recently,ignoring gaps",
          "why": "Contiguous source order matters."
        },
        {
          "id": "3",
          "text": "Any other session's event1",
          "why": "Session identity cannot silently change."
        }
      ],
      "correct": [
        "1"
      ],
      "explanation": "Inclusive last-applied cursor implies next=through+1 ONLY for this named contract."
    }
  ]
