{
  "name": "quantfoundry",
  "version": "4.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/build-content-packs.cjs && next build && node scripts/post-build.cjs",
    "vercel-build": "node scripts/vercel-build.cjs",
    "prestart": "node scripts/preflight.cjs",
    "start": "node .next/standalone/server.js",
    "test": "node --test scripts/unit-tests.mjs",
    "verify:content": "node scripts/validate-content.mjs --registry && node scripts/content-lint.mjs",
    "admin:grant": "node scripts/admin-grant.mjs",
    "lint": "eslint .",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "content:truth": "node scripts/content-truth.mjs",
    "content:spell": "node scripts/spell-check.mjs",
    "content:times": "node scripts/content-times.mjs",
    "content:urls": "node scripts/check-content-urls.mjs",
    "check:expressions": "node scripts/check-expressions.mjs",
    "check:taylor": "node scripts/check-taylor.mjs",
    "check:matrix": "node scripts/check-matrix-square.mjs"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-accordion": "^1.2.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-toast": "^1.2.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^12.23.2",
    "katex": "^0.19.1",
    "lucide-react": "^0.525.0",
    "monaco-editor": "^0.57.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^3.0.3",
    "sharp": "^0.34.3",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/katex": "^0.16.8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "playwright": "^1.65.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "z-ai-web-dev-sdk": "^0.0.18"
  },
  "trustedDependencies": [
    "@prisma/client"
  ]
}
