# ---- Required ----
# PostgreSQL connection string. SQLite is NOT supported on Vercel (ephemeral filesystem).
# Local dev: run any Postgres, e.g. docker run -p 5432:5432 -e POSTGRES_PASSWORD=qf postgres:17
# Vercel: create a Vercel Postgres / Neon / Supabase database and paste its pooled URL here.
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: Initial admin email address for bootstrap
INITIAL_ADMIN_EMAIL=admin@example.com

# ---- Optional ----
# External code-runner service URL. Leave unset for local dev (the runner is
# spawned automatically on 127.0.0.1:3010). On Vercel, code execution needs this
# to point at a runner hosted on a VM/container; without it everything except
# live code submission works.
# CODE_RUNNER_URL=https://your-runner-host:3010
# Shared secret token for authenticating requests between the web app and code-runner:
# CODE_RUNNER_AUTH_TOKEN=generate-a-secure-random-token
